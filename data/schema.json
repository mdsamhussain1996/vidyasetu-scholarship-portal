{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "VidyaSetu Opportunity Schema",
  "type": "object",
  "required": [
    "id",
    "title",
    "section",
    "country",
    "type",
    "category",
    "educationLevel",
    "streams",
    "targetGroup",
    "fundingAmount",
    "amountValINR",
    "provider",
    "eligibility",
    "deadlineText",
    "recurring",
    "status",
    "officialLink",
    "sourceUrl",
    "documentsRequired",
    "applicationProcess",
    "tags",
    "firstSeen",
    "lastVerified",
    "verifiedBy",
    "confidence"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "section": {
      "type": "string",
      "enum": ["india", "abroad"]
    },
    "country": {
      "type": "string"
    },
    "state": {
      "type": ["string", "null"]
    },
    "type": {
      "type": "string",
      "enum": ["government", "private", "university", "individual"]
    },
    "category": {
      "type": "string",
      "enum": [
        "Scholarship",
        "Fellowship",
        "Internship",
        "Research Project",
        "Project Position (JRF/SRF/RA)",
        "Fund/Grant",
        "Competition",
        "Exchange"
      ]
    },
    "educationLevel": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["After 12th", "Bachelor", "Master", "PhD", "Postdoc"]
      },
      "minItems": 1
    },
    "streams": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "targetGroup": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "fundingAmount": {
      "type": "string"
    },
    "amountValINR": {
      "type": "number",
      "minimum": 0
    },
    "provider": {
      "type": "object",
      "required": ["name", "kind", "slug", "website"],
      "properties": {
        "name": { "type": "string" },
        "kind": {
          "type": "string",
          "enum": ["ministry", "company", "trust", "university", "lab", "professor"]
        },
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "website": {
          "type": "string",
          "pattern": "^https://.+"
        }
      }
    },
    "eligibility": {
      "type": "string"
    },
    "incomeLimitINR": {
      "type": ["number", "null"]
    },
    "openDate": {
      "type": ["string", "null"],
      "pattern": "^(\\d{4}-\\d{2}-\\d{2})?$"
    },
    "deadline": {
      "type": ["string", "null"],
      "pattern": "^(\\d{4}-\\d{2}-\\d{2})?$"
    },
    "deadlineText": {
      "type": "string"
    },
    "recurring": {
      "type": "boolean"
    },
    "status": {
      "type": "string",
      "enum": ["open", "upcoming", "closed", "rolling", "needs-review"]
    },
    "officialLink": {
      "type": "string",
      "pattern": "^https://.+"
    },
    "sourceUrl": {
      "type": "string",
      "pattern": "^https://.+"
    },
    "documentsRequired": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "applicationProcess": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "firstSeen": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "lastVerified": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "verifiedBy": {
      "type": "string",
      "enum": ["human", "auto"]
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    }
  }
}
